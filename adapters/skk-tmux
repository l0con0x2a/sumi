#!/bin/sh
# Run in a tmux popup, with the original pane ID passed as $1.
set -eu
pane=${1:?target pane ID required}
case $pane in %*[!0-9]*|%|[!%]*) echo 'invalid pane ID' >&2; exit 1;; esac
# Private file preserves trailing newlines; cancelled TUI writes zero bytes.
umask 077
file=$(mktemp "${TMPDIR:-/tmp}/sumi-skk.XXXXXXXX")
name=sumi-skk-$$
trap 'rm -f "$file"; tmux delete-buffer -b "$name" 2>/dev/null || :' EXIT HUP INT TERM
skk tui > "$file"
[ -s "$file" ] || exit 0
# IDs are stable: a destroyed target is an error, never a fallback to active pane.
tmux load-buffer -b "$name" "$file"
tmux paste-buffer -p -d -b "$name" -t "$pane"
